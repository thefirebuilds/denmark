# Denmark2.0 example environment
# Copy this file to .env and replace placeholder values with your own.
# Do not commit a real .env file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# For Docker Compose on a droplet, use PGHOST=db. For local development without
# Compose, use PGHOST=localhost.
PGHOST=localhost
PGPORT=5432
PGDATABASE=denmark
PGUSER=postgres
PGPASSWORD=replace-with-local-postgres-password
# Prefer mounted secret files in managed deployments:
# PGPASSWORD_FILE=/run/secrets/denmark_pgpassword
PGPOOL_MAX=6
PGIDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=10000
PGKEEPALIVE_INITIAL_DELAY_MS=10000

# Optional connection string for one-off scripts that use DATABASE_URL.
DATABASE_URL=postgres://postgres:replace-with-local-postgres-password@localhost:5432/denmark

# ---------------------------------------------------------------------------
# Frontend / API
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:5000
# Message queue cache tuning. Light/fast queue calls are used for landing-page
# refreshes; keep this short enough that handled work does not feel stale.
MESSAGE_QUEUE_CACHE_MS=10000
MESSAGE_QUEUE_LIGHT_CACHE_MS=60000
MESSAGE_QUEUE_CACHE_MAX_KEYS=12
# Required in production. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-long-random-session-secret
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-or-long-random-secret
DENMARK_BRIDGE_SECRET=replace-with-shared-secret-for-android-bridge
# Secret file alternatives:
# SESSION_SECRET_FILE=/run/secrets/denmark_session_secret
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/denmark_token_encryption_key
# DENMARK_BRIDGE_SECRET_FILE=/run/secrets/denmark_bridge_secret
AUTH_ENFORCED=false
AUTH_COOKIE_SECURE=false
AUTH_OWNER_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Host install tuning
# ---------------------------------------------------------------------------
# setup/install.sh creates host swap on Linux droplets when no swap is active.
# Use 0/off/false to disable, or set a size such as 2G, 4G, or 8192M.
DENMARK_SWAP_SIZE=4G

# Startup background jobs are serialized by default so small tenant hosts do not
# stampede Postgres immediately after boot. Set to 0 to remove the pause.
SCHEDULER_STARTUP_TASK_SPACING_MS=1500
# Recurring background jobs are staggered so the warm tenant does not hit
# Postgres with IMAP, Bouncie, DIMO, alerts, and calendar sync all at once.
SCHEDULER_INTERVAL_OFFSET_STEP_MS=45000

# ---------------------------------------------------------------------------
# Human authentication (OpenID Connect)
# ---------------------------------------------------------------------------
# Set AUTH_ENFORCED=true only when you actually have a working provider config.
# For local development without real login, leave AUTH_ENFORCED=false.
# If OIDC_CLIENT_ID / OIDC_CLIENT_SECRET are omitted, Denmark will fall back to
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET automatically.
OIDC_ENABLED=true
OIDC_PROVIDER_NAME=oidc
OIDC_ISSUER_URL=https://auth.example.com/realms/denmark
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_SCOPES=openid profile email

# Simple Google-based practice setup:
# AUTH_ENFORCED=true
# OIDC_PROVIDER_NAME=google
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID can be omitted if GOOGLE_CLIENT_ID is already set
# OIDC_CLIENT_SECRET can be omitted if GOOGLE_CLIENT_SECRET is already set
# Set the public app URL in Settings > Authentication after bootstrap, then
# copy the computed redirect URI into Google Cloud Console.

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_FMV_MODEL=gpt-4.1-mini
OPENAI_FMV_MARKET_LABEL=Austin, Texas, USA

# ---------------------------------------------------------------------------
# Turo inbox ingestion over IMAP
# ---------------------------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=alerts@example.com
IMAP_PASS=replace-with-imap-app-password
IMAP_TARGET_MAILBOXES=INBOX
IMAP_LOOKBACK_HOURS=72
IMAP_INGEST_LIMIT=100
IMAP_CONNECTION_TIMEOUT=90000
IMAP_GREETING_TIMEOUT=30000
IMAP_SOCKET_TIMEOUT=600000

# ---------------------------------------------------------------------------
# Bouncie telemetry
# ---------------------------------------------------------------------------
BOUNCIE_CLIENT_ID=replace-with-bouncie-client-id
BOUNCIE_CLIENT_SECRET=replace-with-bouncie-client-secret
BOUNCIE_AUTH_CODE=replace-with-one-time-auth-code
BOUNCIE_REDIRECT_URI=http://localhost:5000/api/bouncie/callback

# ---------------------------------------------------------------------------
# DIMO telemetry
# ---------------------------------------------------------------------------
DIMO_CLIENT_ID=replace-with-dimo-client-id
DIMO_REDIRECT_URL=replace-with-dimo-redirect-url
DIMO_API_KEY=replace-with-dimo-api-key
# Optional: use an ENS/name for the vehicle-share QR instead of DIMO_CLIENT_ID.
DIMO_SHARE_TARGET=
DIMO_RPM_HISTORY_LOOKBACK_MINUTES=10

# ---------------------------------------------------------------------------
# Parking economics
# ---------------------------------------------------------------------------
PARKING_SPOT_DAY_RATE=10
PARKING_SPOT_UNLIMITED_PASS_MONTHLY=100
PARKING_SPOT_TRANSPONDER_MONTHLY=6
PARKING_SPOT_RESIDENT_MONTHLY=100
# Optional comma-separated vehicle ids, nicknames, VINs, Turo ids, or DIMO token ids.
PARKING_SPOT_UNLIMITED_VEHICLES=
PARKING_SPOT_PAY_PER_DAY_VEHICLES=
PARKING_SPOT_RESIDENT_VEHICLES=
PARKING_SPOT_TRANSPONDER_VEHICLES=
PARKING_SPOT_TRANSPONDER_EXEMPT_VEHICLES=
PARKING_TRANSFER_MAX_HOURS=1
PARKING_TRANSFER_MPG=25
PARKING_TRANSFER_FUEL_PRICE_PER_GALLON=3.25
PARKING_SPOT_EXPENSE_CATEGORIES=
# Comma-separated vendor/notes match for Park My Share expenses.
PARKING_SPOT_EXPENSE_KEYWORDS=Park My Car Share
# category_or_keyword, category_only, keyword_only, or category_and_keyword.
PARKING_SPOT_EXPENSE_MATCH_MODE=keyword_only

# ---------------------------------------------------------------------------
# Google Calendar sync
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_OAUTH_ACCESS_TYPE=offline
GOOGLE_OAUTH_PROMPT=consent

# ---------------------------------------------------------------------------
# Banking integration fallbacks
# ---------------------------------------------------------------------------
# Plaid is configured in Settings > Integrations. These variables are read only
# until Plaid settings are saved once, to support first-time deployment.
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-sandbox-or-production-secret
PLAID_ENV=sandbox
MERCURY_API_KEY=replace-with-mercury-read-only-api-token

# ---------------------------------------------------------------------------
# HCTRA / EZ TAG toll sync
# ---------------------------------------------------------------------------
EZTAG_USERNAME=replace-with-eztag-username
EZTAG_PASSWORD=replace-with-eztag-password
EZTAG_USER_AGENT=Mozilla/5.0 Denmark2.0 local dev

# ---------------------------------------------------------------------------
# Optional public availability push
# ---------------------------------------------------------------------------
PUBLIC_AVAILABILITY_INGEST_URL=https://example.com/api/availability
PUBLIC_AVAILABILITY_BEARER_TOKEN=replace-with-public-availability-token
PUBLIC_AVAILABILITY_HMAC_SECRET=replace-with-public-availability-hmac-secret

# Vehicle images are served from the frontend/public images directory.
# Example: public/images/geneva.jpg is exposed as /images/geneva.jpg.
